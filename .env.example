# voice-spar secrets — copy to .env and fill in. .env is gitignored.
#
#   cp .env.example .env
#

# ── ElevenLabs — the target agent (X) ────────────────────────────────────────
# Key:  elevenlabs.io → your profile (bottom left) → API Keys → Create
#       Needs Agents read + write scope. Looks like: sk_...
ELEVENLABS_API_KEY=

# Agent ID: dashboard → Agents → open jiohotstar-tara-winback-recovery
#           The ID is in the URL and on the agent page. Starts with agent_
#           This is the ID, NOT the agent name.
ELEVENLABS_AGENT_ID=


# ── Sarvam — the persona brain (Y) and the judge ─────────────────────────────
# Key:  dashboard.sarvam.ai → API Keys
#       Used for chat completions now; also covers Saaras STT + Bulbul TTS at Level 1.
SARVAM_API_KEY=
